---
import { getCollection } from 'astro:content';
import PublicationItem from '../components/PublicationItem.astro';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = (
  await getCollection('publications', ({ data }) => !data.draft && data.visibility === 'public')
).sort((a, b) => a.data.order - b.data.order);

---

<BaseLayout
  title="Research — Geping Chen"
  description="Research interests and publications by Geping Chen in causal inference, tabular foundation models, precision medicine, agricultural statistics, and experimental design."
>
  <header class="page-hero">
    <div class="shell reading-column">
      <p class="eyebrow">Research</p>
      <h1>Statistical methods for consequential decisions.</h1>
      <p class="page-intro">My work connects identifiable causal questions with modern predictive models, while keeping uncertainty, assumptions, and reproducibility visible.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="interests-title">
    <div class="shell reading-column">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Research interests</p>
          <h2 id="interests-title">Five connected directions.</h2>
        </div>
        <p>These themes span methodological research and applications where statistical decisions must remain interpretable and defensible.</p>
      </div>
      <div class="interest-grid">
        {profile.researchInterests.map((interest) => (
          <article class="interest-card">
            <h3>{interest.title}</h3>
            <p>{interest.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="publications-title">
    <div class="shell reading-column">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Publications</p>
          <h2 id="publications-title">Published work & preprints.</h2>
        </div>
        <p>Statuses reflect the linked publisher or preprint record. Manuscripts in preparation are intentionally omitted from this public release.</p>
      </div>
      <div class="publication-list">
        {publications.map((publication) => <PublicationItem publication={publication} />)}
      </div>
    </div>
  </section>

  <section class="contact-band" aria-labelledby="research-contact-title">
    <div class="shell reading-column contact-band-grid">
      <h2 id="research-contact-title">Discuss a research direction.</h2>
      <div>
        <p>For questions about a paper, method, or potential collaboration, email is the most direct route.</p>
        <a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
