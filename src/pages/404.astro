---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Geping Chen"
  description="The requested page could not be found on Geping Chen's website."
>
  <section class="shell not-found">
    <div>
      <p class="eyebrow">404 · Page not found</p>
      <h1>This path does not exist.</h1>
      <p>The page may have moved, or the address may be incomplete. Use the main navigation or return to the homepage.</p>
      <a class="button" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
