---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { zhimaPhotos } from '../data/zhima-photos';
---

<BaseLayout
  title="Zhima — Geping Chen"
  description="Meet Zhima, Geping Chen’s cat, and learn how she got her Chinese name."
>
  <header class="page-hero zhima-hero">
    <div class="shell reading-column">
      <p class="eyebrow">Zhima · <span lang="zh">芝麻</span></p>
      <h1>Meet Zhima.</h1>
      <p class="page-intro">Our eleven-month-old cat and a much-loved member of our family.</p>
    </div>
  </header>

  <section class="section" aria-labelledby="zhima-story-title">
    <div class="shell reading-column zhima-story">
      <h2 id="zhima-story-title">How she got her name</h2>
      <p>
        We adopted Zhima in August 2026. At the time, her English name was Sushi. We tried many
        Chinese names, and <span lang="zh">“芝麻”</span> (Zhima) was the first one she responded to.
        That is how she got her Chinese name. <span lang="zh">芝麻</span> means “sesame” in English.
      </p>
    </div>
  </section>

  <section class="section section-contrast" aria-labelledby="zhima-photos-title">
    <div class="shell reading-column zhima-photos">
      <h2 id="zhima-photos-title">Photos</h2>
      <div class="photo-grid">
        {zhimaPhotos.map((photo) => (
          <figure>
            <div class="photo-frame">
              <Image
                src={photo.image}
                alt={photo.alt}
                width={900}
                format="webp"
                quality={82}
                loading="lazy"
                style={`object-position: ${photo.position}; transform: scale(${photo.scale}); transform-origin: ${photo.position};`}
              />
            </div>
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .zhima-hero h1 {
    margin-bottom: 0.9rem;
  }

  .zhima-story p {
    max-width: 42rem;
    margin-bottom: 0;
  }

  .zhima-story p {
    font-size: clamp(1.08rem, 2vw, 1.2rem);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .photo-grid figure {
    min-width: 0;
    margin: 0;
  }

  .photo-frame {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.35rem;
    background: var(--color-line);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    text-align: center;
  }

  @media (max-width: 36rem) {
    .photo-grid {
      grid-template-columns: 1fr;
      max-width: 16rem;
      margin-inline: auto;
      gap: 1.75rem;
    }
  }
</style>
