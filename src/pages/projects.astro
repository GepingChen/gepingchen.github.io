---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft && data.visibility === 'public')
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects — Geping Chen"
  description="Selected research projects by Geping Chen, with concise summaries, keywords, and public links."
>
  <header class="page-hero">
    <div class="shell reading-column">
      <p class="eyebrow">Projects</p>
      <h1>Selected projects.</h1>
    </div>
  </header>

  <section class="section" aria-label="Project list">
    <div class="shell reading-column">
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
