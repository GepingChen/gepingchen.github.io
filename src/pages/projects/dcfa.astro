---
const destination = '/projects/agentic-tabcf/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Agentic TabCF</title>
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <script is:inline>location.replace('/projects/agentic-tabcf/');</script>
  </head>
  <body>
    <p>This project has moved to <a href={destination}>Agentic TabCF</a>.</p>
  </body>
</html>
