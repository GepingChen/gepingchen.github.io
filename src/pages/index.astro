---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portraitImage from '../assets/profile-portrait.jpg';
import PresentationItem from '../components/PresentationItem.astro';
import { profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const presentations = (
  await getCollection('presentations', ({ data }) => !data.draft && data.visibility === 'public')
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Geping Chen — Statistics, Causal Inference & Tabular ML"
  description="Geping Chen is a Statistics PhD Candidate working on AI-enhanced causal inference and the pretraining and post-training of tabular foundation models."
>
  <section class="home-intro">
    <div class="shell reading-column home-intro-grid">
      <h1>{profile.name}</h1>
      <figure class="home-portrait">
        <Image
          src={portraitImage}
          alt="Portrait of Geping Chen"
          width={416}
          height={416}
          format="webp"
          quality={84}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="home-intro-details">
        <p>
          I’m a PhD Candidate in Statistics at Iowa State University, under the supervision of{' '}
          <a class="advisor-link" href={profile.doctoralAdvisors[0].url}>{profile.doctoralAdvisors[0].name}</a>{' '}
          and{' '}
          <a class="advisor-link" href={profile.doctoralAdvisors[1].url}>{profile.doctoralAdvisors[1].name}</a>.
        </p>
        <p>
          My research interests are AI-enhanced causal inference and the pretraining and
          post-training of tabular foundation models.
        </p>
        <p>
          Before that, I completed my bachelor’s degree in Statistics at Renmin University of China
          under the supervision of{' '}
          <a class="advisor-link" href={profile.undergraduateAdvisors[0].url}>{profile.undergraduateAdvisors[0].name}</a>{' '}
          and{' '}
          <a class="advisor-link" href={profile.undergraduateAdvisors[1].url}>{profile.undergraduateAdvisors[1].name}</a>.
        </p>
        <nav class="profile-links" aria-label="Profile links">
          <a href="/projects/">Projects & publications</a>
          <a href={`mailto:${profile.email}`}>Email</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="section section-contrast home-news" aria-labelledby="presentations-title">
    <div class="shell reading-column">
      <div class="section-heading">
        <h2 id="presentations-title">News</h2>
      </div>
      <div class="presentation-list">
        {presentations.map((presentation) => <PresentationItem presentation={presentation} />)}
      </div>
    </div>
  </section>
</BaseLayout>
