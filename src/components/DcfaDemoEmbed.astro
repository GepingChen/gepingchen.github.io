---
interface Props {
  demoUrl: string;
  title?: string;
}

const {
  demoUrl,
  title = 'DCFA auditable causal agent demo',
} = Astro.props;
const parsedUrl = new URL(demoUrl);

if (!['http:', 'https:'].includes(parsedUrl.protocol)) {
  throw new Error('DcfaDemoEmbed requires an HTTP or HTTPS demo URL.');
}
---

<section class="dcfa-demo" aria-labelledby="dcfa-demo-title">
  <div class="dcfa-demo-heading">
    <div>
      <p class="eyebrow">Interactive demo</p>
      <h2 id="dcfa-demo-title">See the agent’s gates and evidence trail.</h2>
    </div>
    <a href={parsedUrl.href}>Open in a new tab <span aria-hidden="true">↗</span></a>
  </div>
  <div class="dcfa-demo-frame">
    <iframe
      src={parsedUrl.href}
      title={title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      sandbox="allow-downloads allow-forms allow-same-origin allow-scripts"
    ></iframe>
  </div>
  <p class="dcfa-demo-fallback">
    If the embedded view does not load, <a href={parsedUrl.href}>open the demo directly</a>.
  </p>
</section>

<style>
  .dcfa-demo {
    margin-block: clamp(2.5rem, 7vw, 4.5rem);
  }

  .dcfa-demo-heading {
    display: flex;
    margin-bottom: 1rem;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .dcfa-demo-heading h2,
  .dcfa-demo-heading p {
    margin-bottom: 0;
  }

  .dcfa-demo-heading > a,
  .dcfa-demo-fallback {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 650;
  }

  .dcfa-demo-heading > a {
    display: inline-flex;
    min-height: 2.75rem;
    flex: none;
    align-items: center;
  }

  .dcfa-demo-frame {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 0.35rem;
    background: var(--color-surface);
  }

  iframe {
    display: block;
    width: 100%;
    height: min(78rem, 86vh);
    min-height: 44rem;
    border: 0;
  }

  .dcfa-demo-fallback {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .dcfa-demo-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.4rem;
    }

    iframe {
      height: 72rem;
      min-height: 0;
    }
  }
</style>
